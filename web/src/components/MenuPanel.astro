---
import Sub from './Sub.astro'
import {img} from '../lib/helpers'
const {r} = Astro.props
const menuImg = img(r.menuImage, 800)
---
<Sub id={`menu-${r.slug}`} title="MENU" titleJa="メニュー">
  {(r.menu || []).map((cat: any, i: number) => (
    <>
      <section class="menu-cat">
        <h3>{cat.titleJa}{cat.titleEn && <span>{cat.titleEn}</span>}</h3>
        <ul>
          {(cat.items || []).map((it: any) => {
            const preview = img(it.image, 480)
            return (
              <li class="menu-item" data-img={preview || undefined}>
                <span>{it.name}{it.note && <small>（{it.note}）</small>}</span>
                <span>{it.price}</span>
              </li>
            )
          })}
        </ul>
      </section>
      {i === 0 && menuImg && <img class="menu-photo" src={menuImg} alt="" loading="lazy" />}
    </>
  ))}
  {r.menuNote && <p class="menu-note">{r.menuNote}</p>}
</Sub>
