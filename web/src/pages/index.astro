---
// La mise en page est dans src/lib/render.ts (partagée avec le navigateur, cf. scripts/live.ts)
import '@fontsource/noto-sans-jp/400.css'
import '@fontsource/noto-sans-jp/600.css'
import '@fontsource/noto-sans-jp/700.css'
import '../styles/global.css'
import {getSite, projectId, dataset} from '../lib/sanity'
import {renderApp, signature, images} from '../lib/render'

const data = await getSite()
const cfg = {projectId, dataset}
const s = data?.settings || {}
const restaurants = data?.restaurants || []
const company = s.companyName || 'TORIKO INC.'
const og = images(cfg).img(s.ogImage, 1200, 630)
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- couleur de la barre mobile, mise à jour par panels.ts -->
    <meta name="theme-color" content="#f3eee6" />
    <script is:inline>
      // Évite le flash Hiragino → Noto : on masque le site jusqu'au chargement de la police (max 1,5 s)
      (function () {
        var d = document.documentElement
        if (!document.fonts || !document.fonts.load) return
        d.classList.add('fonts-wait')
        var done = function () { d.classList.remove('fonts-wait') }
        Promise.race([
          Promise.all([
            document.fonts.load('600 1em "Noto Sans JP"', 'TORIKO鳥'),
            document.fonts.load('400 1em "Noto Sans JP"', 'TORIKO鳥'),
          ]),
          new Promise(function (r) { setTimeout(r, 1500) }),
        ]).then(done, done)
      })()
    </script>
    {projectId && <link rel="preconnect" href={`https://${projectId}.apicdn.sanity.io`} crossorigin />}
    <title>{company}</title>
    {s.seoDescription && <meta name="description" content={s.seoDescription} />}
    <meta property="og:title" content={company} />
    {og && <meta property="og:image" content={og} />}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: company,
      subOrganization: restaurants.map((r: any) => ({
        '@type': 'Restaurant',
        name: `${r.nameEn} ${r.nameJa}`,
        address: r.address,
        telephone: r.phone,
        openingHours: r.hours,
      })),
    })} />
  </head>
  <body class="no-anim">
    <div id="app" set:html={renderApp(data, cfg)} />

    <script id="site-config" type="application/json" set:html={JSON.stringify({...cfg, sig: signature(data)})} />

    <script>
      import {initPanels} from '../scripts/panels'
      import {initMenuHover} from '../scripts/menuHover'
      import {initSwipe} from '../scripts/swipe'
      import {initLive} from '../scripts/live'
      import {initGallery} from '../scripts/gallery'
      import {initFitList} from '../scripts/fitList'

      let cleanups: Array<() => void> = []
      const init = () => {
        cleanups.forEach((fn) => fn())
        cleanups = [initPanels(), initMenuHover(), initFitList()]
        initSwipe() // écouteurs posés sur les panneaux → partent avec eux
        initGallery()
      }
      init()
      initLive(init)
    </script>
  </body>
</html>
